NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Push notifications (npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=chave-publica-vapid
VAPID_PRIVATE_KEY=chave-privada-vapid

# Supabase -> Project Settings -> API -> service_role (NUNCA exponha no client)
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Qualquer string aleatória longa — protege a rota de cron
CRON_SECRET=string-aleatoria-longa
